<mxfile host="app.diagrams.net" type="device">
  <diagram name="Manage Credentials Threat Tree" id="tta-manage-credentials">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="700" pageHeight="400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Root: compromise -->
        <mxCell id="root" value="Credential Management&#xa;is Compromised" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="240" y="20" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- Attacks (yellow) -->
        <mxCell id="a1" value="Credentials stored in plaintext&#xa;or with weak encryption" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="150" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="a2" value="Plaintext secrets leak&#xa;via logs or error messages" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="250" y="150" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="a3" value="IDOR exposes credentials&#xa;from other users' vaults" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="480" y="150" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- Mitigations (green) -->
        <mxCell id="m1" value="Encrypt at rest with&#xa;authenticated encryption&#xa;(AES-GCM) + separate key store" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="280" width="180" height="80" as="geometry" />
        </mxCell>

        <mxCell id="m2" value="Never log secrets; use&#xa;masked / structured&#xa;logging and generic errors" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="250" y="280" width="180" height="80" as="geometry" />
        </mxCell>

        <mxCell id="m3" value="Enforce vault-ownership&#xa;checks on every read /&#xa;reveal operation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="480" y="280" width="180" height="80" as="geometry" />
        </mxCell>

        <!-- Root -> attacks -->
        <mxCell id="e1" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="root" target="a1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="root" target="a2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="root" target="a3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Attacks -> mitigations -->
        <mxCell id="e4" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a1" target="m1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a2" target="m2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a3" target="m3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
