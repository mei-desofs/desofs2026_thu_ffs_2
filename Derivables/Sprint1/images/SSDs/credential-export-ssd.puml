@startuml
skinparam maxMessageSize 150
autonumber

actor "User" as User
participant ":KryptosSystem" as System

User -> System : exportVault(vaultId, authenticationToken)
activate System

alt Invalid or Expired Token
    System --> User : 401 Unauthorized (Authentication Failed)
    note right : Audit Log: AUTH_FAILURE
else Valid Token

    note over System : System verifies vault ownership (Authorization)

    alt User is NOT the Vault Owner
        System --> User : 403 Forbidden (Access Denied)
        note right : Audit Log: UNAUTHORIZED_ACCESS_ATTEMPT
    else User is Authorized Owner
        System -> System : Retrieve data and generate secure file
        System --> User : 200 OK (Returns credentials file)
        note right : Audit Log: EXPORT_SUCCESS
    end
end

deactivate System
@enduml