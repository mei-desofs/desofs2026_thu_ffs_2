@startuml
skinparam maxMessageSize 150
autonumber

actor "User" as User
participant "CredentialServiceController" as API
participant "CredentialTransferService" as Service
database "VaultRepository" as VRepo
database "AuditRepository" as ARepo
participant "FileSystemAdapter" as FS

User -> API : POST /api/vaults/{vaultId}/credentials/import\n(File, JWT)
activate API

note over API : 1. Authentication
API -> API : validateToken(JWT)

alt Invalid Token
    API --> User : 401 Unauthorized
else Valid Token

    note over API, Service : 2. Authorization
    API -> Service : verifyVaultOwnership(vaultId, userId)
    activate Service
    Service -> VRepo : findById(vaultId)
    Service --> API : boolean (isOwner)
    deactivate Service

    alt Vault does not belong to userId
        API -> ARepo : save(AuditRecord("UNAUTHORIZED_ACCESS_ATTEMPT"))
        API --> User : 403 Forbidden
    else User is Authorized Owner

        note over API, FS : 3. OS Interaction
        API -> FS : writeTempFile(fileStream, safeFileName)
        activate FS
        FS --> API : tempFilePath
        deactivate FS

        API -> FS : readTempFile(tempFilePath)
        activate FS
        FS --> API : fileContent
        deactivate FS

        note over API, Service : 4. Business Logic (Validation & Transfer)
        ' AQUI ESTÁ A CORREÇÃO: O Controller delega no Serviço!
        ref over API, Service : See SD: Credential Validation & Transfer
        API -> Service : processAndTransferCredentials(fileContent, vaultId, masterKey)
        activate Service

        alt Malicious Content or Invalid Schema
            Service --> API : throws SecurityValidationException
            API -> ARepo : save(AuditRecord("IMPORT_VALIDATION_FAILURE"))
            API --> User : 400 Bad Request
        else Transfer Succeeds
            Service --> API : success
            deactivate Service
            API -> ARepo : save(AuditRecord("CREDENTIAL_IMPORT_SUCCESS"))
            API --> User : 200 OK
        end

        note over API, FS : 5. Credential Cleanup
        API -> FS : secureWipe(tempFilePath)
        activate FS
        FS --> API : file overwritten & deleted
        deactivate FS
    end
end
deactivate API
@enduml