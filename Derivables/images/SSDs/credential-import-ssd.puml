@startuml
skinparam maxMessageSize 150
autonumber

actor "User" as User
participant ":KryptosSystem" as System

User -> System : importCredentials(vaultId, fileContent, authenticationToken)
activate System

alt Invalid or Expired Token
    System --> User : 401 Unauthorized (Authentication Failed)
    note right : Audit Log: AUTH_FAILURE
else Valid Token
    note over System : System verifies vault ownership (Authorization)
    alt User is NOT the Vault Owner
        System --> User : 403 Forbidden (Access Denied)
        note right : Audit Log: UNAUTHORIZED_ACCESS_ATTEMPT
    else User is Authorized Owner

        note over System : System validates file format and safety (Input Validation)

        alt Malicious Content or Invalid Schema
            System --> User : 400 Bad Request (Validation Failed)
            note right : Audit Log: IMPORT_VALIDATION_FAILURE
        else Valid & Secure File
            System -> System : Encrypt data and update database
            System -> System : Secure wipe of temporary OS files
            System --> User : 200 OK (Import Successful)
            note right : Audit Log: IMPORT_SUCCESS
        end
    end
end

deactivate System
@enduml