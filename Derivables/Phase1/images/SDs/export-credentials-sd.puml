@startuml
skinparam maxMessageSize 150
autonumber

actor "User" as User
participant "CredentialServiceController" as API
participant "CredentialTransferService" as Service
database "VaultRepository" as VRepo
database "CredentialRepository" as CRepo
database "AuditRepository" as ARepo
participant "FileSystemAdapter" as FS

User -> API : GET /api/vaults/{vaultId}/credentials/export\n(Authorization: Bearer JWT)
activate API

note over API : 1. Authentication
API -> API : validateToken(JWT)

alt Invalid Token
    API --> User : 401 Unauthorized
else Valid Token

    note over API, Service : 2. Authorization
    API -> Service : verifyVaultOwnership(vaultId, userId)
    activate Service
    Service -> VRepo : findById(vaultId)
    Service --> API : boolean (isOwner)
    deactivate Service

    alt Vault does not belong to userId
        API -> ARepo : save(AuditRecord("UNAUTHORIZED_ACCESS_ATTEMPT"))
        API --> User : 403 Forbidden
    else User is Authorized Owner

        note over API, Service : 3. Business Logic & Cryptography
        API -> Service : retrieveAndDecryptCredentials(vaultId, masterKey)
        activate Service
        Service -> CRepo : findByVaultId(vaultId)
        activate CRepo
        CRepo --> Service : encryptedCredentials
        deactivate CRepo
        note right of Service : Service decrypts credentials\nand formats to JSON/CSV
        Service --> API : credentialsFileContent
        deactivate Service

        note over API, FS : 4. OS Interaction & Download
        API -> FS : writeTempFile(credentialsFileContent, safeFileName)
        activate FS
        FS --> API : tempFilePath
        deactivate FS

        API -> FS : streamFileToClient(tempFilePath)
        activate FS
        FS --> API : fileStream
        deactivate FS

        API -> ARepo : save(AuditRecord("CREDENTIAL_EXPORT_SUCCESS"))
        API --> User : 200 OK (File Download)

        note over API, FS : 5. Credential Cleanup
        API -> FS : secureWipe(tempFilePath)
        activate FS
        FS --> API : file overwritten & deleted
        deactivate FS
    end
end
deactivate API
@enduml