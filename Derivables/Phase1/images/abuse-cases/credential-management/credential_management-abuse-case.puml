@startuml
left to right direction
hide stereotype
skinparam defaultTextAlignment center

skinparam usecase {
    BackgroundColor<<Abuse>> Black
    FontColor<<Abuse>> White
    BorderColor<<Abuse>> Black
}

actor "User" as User
actor "Attacker" as Attacker

usecase "Create Credential" as UC_Create
usecase "View Credentials" as UC_View
usecase "Update Credential" as UC_Update
usecase "Delete Credential" as UC_Delete

usecase "Verify Vault Ownership" as UC_Verify
usecase "End-to-End Encryption" as UC_E2EE
usecase "Rate Limiting & Quotas" as UC_Rate

usecase "Unauthorized Access" as AC_IDOR <<Abuse>>
usecase "Credential Tampering" as AC_Tampering <<Abuse>>
usecase "Mass Data Exfiltration" as AC_Exfiltration <<Abuse>>
usecase "Malicious Deletion" as AC_MalDelete <<Abuse>>

User --> UC_Create
User --> UC_View
User --> UC_Update
User --> UC_Delete

UC_View ..> UC_Verify : <<includes>>
UC_View ..> UC_Rate : <<includes>>
UC_Update ..> UC_E2EE : <<includes>>
UC_Delete ..> UC_Verify : <<includes>>

UC_Verify ..> AC_IDOR : <<mitigates>>
UC_E2EE ..> AC_Tampering : <<mitigates>>
UC_Rate ..> AC_Exfiltration : <<mitigates>>
UC_Verify ..> AC_MalDelete : <<mitigates>>

UC_View <.. AC_IDOR : <<threatens>>
UC_Update <.. AC_Tampering : <<threatens>>
UC_View <.. AC_Exfiltration : <<threatens>>
UC_Delete <.. AC_MalDelete : <<threatens>>

AC_IDOR <-- Attacker
AC_Tampering <-- Attacker
AC_Exfiltration <-- Attacker
AC_MalDelete <-- Attacker
@enduml