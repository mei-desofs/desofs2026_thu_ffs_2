@startuml
left to right direction
hide stereotype
skinparam defaultTextAlignment center

skinparam usecase {
    BackgroundColor<<Abuse>> Black
    FontColor<<Abuse>> White
    BorderColor<<Abuse>> Black
}

actor "Administrator" as Admin
actor "Attacker" as Attacker

usecase "View All Users" as UC_View
usecase "Assign Role to User" as UC_Assign
usecase "Update/Delete User" as UC_Delete
usecase "View Audit Logs" as UC_Audit

usecase "Strict RBAC Verification" as UC_RBAC
usecase "Data Pagination & Minimization" as UC_Pagination
usecase "Admin Re-authentication / MFA" as UC_ReAuth
usecase "Sensitive Field Masking" as UC_Masking

usecase "Privilege Escalation" as AC_Privilege <<Abuse>>
usecase "Profile Data Scraping" as AC_Scraping <<Abuse>>
usecase "Mass Account Lockout" as AC_Lockout <<Abuse>>
usecase "Admin Account Takeover" as AC_Takeover <<Abuse>>

Admin --> UC_View
Admin --> UC_Assign
Admin --> UC_Delete
Admin --> UC_Audit

UC_Assign ..> UC_RBAC : <<includes>>
UC_Delete ..> UC_ReAuth : <<includes>>
UC_View ..> UC_Pagination : <<includes>>
UC_Audit ..> UC_Masking : <<includes>>

UC_RBAC ..> AC_Privilege : <<mitigates>>
UC_Pagination ..> AC_Scraping : <<mitigates>>
UC_ReAuth ..> AC_Lockout : <<mitigates>>
UC_ReAuth ..> AC_Takeover : <<mitigates>>

UC_Assign <.. AC_Privilege : <<threatens>>
UC_View <.. AC_Scraping : <<threatens>>
UC_Delete <.. AC_Lockout : <<threatens>>
UC_Audit <.. AC_Takeover : <<threatens>>

AC_Privilege <-- Attacker
AC_Scraping <-- Attacker
AC_Lockout <-- Attacker
AC_Takeover <-- Attacker
@enduml