@startuml
skinparam maxMessageSize 150
autonumber

participant "CredentialTransferService" as Service
participant "InputValidator" as Validator
participant "SchemaChecker" as Schema
participant "Sanitizer" as Sanitizer
participant "EncryptionService" as Crypto
database "CredentialRepository" as CRepo

-> Service : processAndTransferCredentials\n(fileContent, vaultId, masterKey)
activate Service

note over Service, Sanitizer : 1. Input Validation
Service -> Validator : parseAndValidate(fileContent)
activate Validator

note over Validator : Resource Exhaustion Prevention (DoS)
Validator -> Validator : checkMaximumSize(fileContent)
alt File Too Large or Malformed
    Validator --> Service : throws SecurityValidationException
end

Validator -> Validator : parseToJsonOrCsv(fileContent)

note over Validator, Schema : Structural Integrity
Validator -> Schema : validateStructure(parsedData)
activate Schema
Schema --> Validator : valid schema
deactivate Schema

note over Validator, Sanitizer : Injection Prevention (XSS/SQLi)
loop For each credential entry
    Validator -> Sanitizer : sanitize(entry.fields)
    activate Sanitizer
    Sanitizer -> Sanitizer : remove malicious HTML/JS tags
    Sanitizer --> Validator : clean entry
    deactivate Sanitizer
end

Validator --> Service : validCredentials
deactivate Validator

note over Service, Crypto : 2. Encryption & Persistence
loop For each valid credential
    Service -> Crypto : encryptPayload(credential.password, masterKey)
    activate Crypto
    Crypto --> Service : EncryptedCredential
    deactivate Crypto

    Service -> CRepo : save(EncryptedCredential)
    activate CRepo
    CRepo --> Service : saveSuccess
    deactivate CRepo
end

<-- Service : success
deactivate Service
@enduml